{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "aws-lambda",
    "outDir": "dist-lambda",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["aws-lambda/**/*.ts", "aws-lambda/**/*.d.ts"]
}